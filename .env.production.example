APP_NAME=MiniX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minix_production
DB_USERNAME=minix_dbuser
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# CẢNH BÁO BẢO MẬT VỀ SESSION COOKIE:
# SESSION_SECURE_COOKIE=true CHỈ BẬT KHI CHẠY TRÊN HTTPS CÓ CHỨNG CHỈ SSL HỢP LỆ!
# TUYỆT ĐỐI KHÔNG bật khi chạy thử nghiệm trên HTTP localhost vì trình duyệt sẽ từ chối gửi cookie và hỏng đăng nhập.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cấu hình gửi mail thực tế qua SMTP (Gmail / Amazon SES / SendGrid):
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Khóa API Google Gemini cho MiniX AI Bot:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

